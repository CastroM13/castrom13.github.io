{
  "version": 4,
  "terraform_version": "1.12.0",
  "serial": 42,
  "lineage": "fixture-lineage-secret",
  "outputs": {
    "database_password": { "value": "fixture-db-secret", "type": "string", "sensitive": true }
  },
  "resources": [
    {
      "mode": "managed",
      "type": "aws_instance",
      "name": "api",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "index_key": 0,
          "attributes": { "instance_type": "t3.small", "password": "fixture-resource-secret" },
          "sensitive_attributes": [[{ "type": "get_attr", "value": "password" }]],
          "dependencies": ["aws_vpc.main"],
          "private": "fixture-private-blob"
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_vpc",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [{ "attributes": { "cidr_block": "10.0.0.0/16" }, "dependencies": [] }]
    }
  ]
}
